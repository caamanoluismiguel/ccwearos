<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred (Android 12+ ignores allowBackup for
     device-to-device transfer, hence these rules): the anonymous Firebase
     session and RTDB cache belong to this watch only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
